# ─────────────────────────────────────────
# CrowdSec en PAQUET NATIF sur l'hôte
# La LAPI doit écouter sur l'IP locale du serveur
# et non sur 127.0.0.1 (inaccessible depuis Docker)
# Modifier /etc/crowdsec/config.yaml :
#   api.server.listen_uri: 192.168.1.30:8080
# ─────────────────────────────────────────
CROWDSEC_URL=http://192.168.1.30:8080

# ─────────────────────────────────────────
# CrowdSec en DOCKER
# Mettre les deux conteneurs sur le même réseau Docker
# et utiliser le nom du service CrowdSec comme hostname
# ─────────────────────────────────────────
# CROWDSEC_URL=http://crowdsec:8080

# Compte machine CrowdSec dédié
CROWDSEC_USER=crowdsec-web-ui
CROWDSEC_PASSWORD=<généré avec openssl rand -hex 32>

# Paramètres optionnels
CROWDSEC_REFRESH_INTERVAL=30s
CROWDSEC_LOOKBACK_PERIOD=168h
CROWDSEC_LAPI_REQUEST_TIMEOUT=30s
